# Android / Gradle
# (no leading slash on any of these — the actual project lives in
# android/app/, not the repo root, so patterns must match at any depth)
*.iml
.gradle/
local.properties
.idea/
.DS_Store
build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab

# Release signing -- never committed, ever.
*.keystore
*.jks
keystore-DO-NOT-COMMIT/

# Backend (Python)
__pycache__/
*.pyc
.venv/
venv/

# Backend data artifacts (fetched/generated, not source)
backend/output/
backend/*.grib2
backend/*.tmp

# OS / editor cruft
Thumbs.db
.vscode/
